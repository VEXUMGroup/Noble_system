NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# If your Supabase project provides a publishable key instead, this is also supported:
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Needed for OAuth redirect/callback URLs (no trailing slash)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Required when the server refreshes Google Calendar access tokens.
# Use the same Google OAuth client configured in Supabase Auth > Providers > Google.
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
