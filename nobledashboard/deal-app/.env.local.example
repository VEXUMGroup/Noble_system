NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# If your Supabase project provides a publishable key instead, this is also supported:
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
#
# Optional (recommended when you need to bypass RLS on server-side):
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Needed for OAuth redirect/callback URLs (no trailing slash)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Required to sign the app session cookie (generate a long random string).
APP_AUTH_SECRET=change-me-to-a-long-random-string

# Required for Web Push notifications on iPhone/PWA.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:admin@example.com

# Required when the server refreshes Google Calendar access tokens.
# Use the same Google OAuth client configured in Supabase Auth > Providers > Google.
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
